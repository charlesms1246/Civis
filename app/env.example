# ====== CIVIS — ENVIRONMENT CONFIGURATION ======
# Copy this file to .env.local and fill in the values for your deployment.
# See docs/DEVELOPER.md for full setup instructions.
# See docs/resources/creditcoin-chain-reference.md for Creditcoin chain details.

# ====== CHAIN ======
# Primary target: Creditcoin Testnet
NEXT_PUBLIC_CHAIN_ID=102031
NEXT_PUBLIC_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Local Anvil (uncomment for local development)
# NEXT_PUBLIC_CHAIN_ID=31337
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# ====== BLOCKSCOUT ======
NEXT_PUBLIC_BLOCKSCOUT_URL=https://creditcoin-testnet.blockscout.com
NEXT_PUBLIC_BLOCKSCOUT_API_KEY=

# ====== CIVIS CONTRACT ADDRESSES ======
# Set these after running the deployment script.
# See docs/DEVELOPER.md §5a or contracts/deployments/creditcoin-testnet.json
NEXT_PUBLIC_CIVIS_NFT_CONTRACT=
NEXT_PUBLIC_CIVIS_TOKEN_CONTRACT=
NEXT_PUBLIC_CIVIS_VERIFIER_CONTRACT=

# ====== EMAIL PROVER ADDRESSES ======
# Set these after running: bun run contracts/vlayer/deploy.ts
# See docs/DEVELOPER.md §5b
NEXT_PUBLIC_CIVIS_WIKIPEDIA_PROVER=
NEXT_PUBLIC_CIVIS_REDCROSS_PROVER=
NEXT_PUBLIC_CIVIS_MSF_PROVER=

# ====== WALLETCONNECT / RAINBOWKIT ======
# Get a project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ====== VLAYER PROOF CONFIGURATION ======
# Civis uses @vlayer/sdk v1.0.1 (EmailProofLib / DKIM email proof flow).
# This is separate from vlayer's newer TLSNotary web-proof API.
#
# Option A — Test prover (no API token, no real ZK computation):
#   NEXT_PUBLIC_VLAYER_PROVER_URL=https://stable-fake-prover.vlayer.xyz/
#   NEXT_PUBLIC_VLAYER_DNS=https://stable-fake-prover.vlayer.xyz
#   NEXT_PUBLIC_VLAYER_API_TOKEN=
#
# Option B — Production prover (contact vlayer team for access):
#   NEXT_PUBLIC_VLAYER_PROVER_URL=https://prove.vlayer.xyz
#   NEXT_PUBLIC_VLAYER_DNS=https://prove.vlayer.xyz
#   NEXT_PUBLIC_VLAYER_API_TOKEN=<your-api-token>
#
# Option C — Local vlayer devnet (Docker, advanced):
#   NEXT_PUBLIC_VLAYER_PROVER_URL=http://127.0.0.1:3000
#   NEXT_PUBLIC_VLAYER_DNS=http://127.0.0.1:3002
#   NEXT_PUBLIC_VLAYER_API_TOKEN=
NEXT_PUBLIC_VLAYER_PROVER_URL=
NEXT_PUBLIC_VLAYER_DNS=
NEXT_PUBLIC_VLAYER_API_TOKEN=

# ====== BLOCKSCOUT MERITS ======
NEXT_PUBLIC_BLOCKSCOUT_MERITS_URL=https://merits.blockscout.com

# ====== tCTC NATIVE REWARD DISTRIBUTOR ======
# Funded wallet that sends tCTC to users who redeem CIVIS tokens in the shop.
# The private key is only used server-side in app/api/rewards/ctc-topup/route.ts
# Mark CTC_REWARD_DISTRIBUTOR_PRIVATE_KEY as a secret in Vercel / CI.
CTC_REWARD_DISTRIBUTOR_PRIVATE_KEY=
CTC_REWARD_DISTRIBUTOR_ADDRESS=

# ====== DEVELOPMENT ======
NODE_ENV=development
